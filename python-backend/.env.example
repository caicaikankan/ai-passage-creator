# ========================================
# AI 文章创作器 - Python 后端环境变量示例
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会提交到仓库
# ========================================

# 火山引擎方舟（Ark）AI 配置 —— 必填
# 申请地址：https://www.volcengine.com/product/ark
# 注意：使用 Coding Plan 配额请保持 base_url 为 /api/coding/v3，
# 不要改为 /api/v3 否则会按推理 token 单独计费。
ARK_API_KEY=your-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_MODEL=ark-code-latest
